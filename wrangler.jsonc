{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stemforge",
  "compatibility_date": "2026-05-01",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ADMIN_EMAIL": "andrewsmusiclab@gmail.com",
    "SITE_URL": "https://stemforge.studio",
    "GOOGLE_CLIENT_ID": "651689276754-6hgjfc7olij98f2t42l0df8ei6oduldu.apps.googleusercontent.com",
    "STRIPE_CREATOR_PRICE_ID": "price_1TqKUSBGtMHyMzRlSqmFzjv3",
    "STRIPE_PRO_PRICE_ID": "price_1TqKWHBGtMHyMzRlY1IhNBh8",
    "STRIPE_CREATOR_PRICE_ID_LEGACY": "price_1TqKUSBGtMHyMzRlSqmFzjv3",
    "STRIPE_PRO_PRICE_ID_LEGACY": "price_1TqKWHBGtMHyMzRlY1IhNBh8"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "andrew-pryce-db",
      "database_id": "ffd0c782-4ccc-42c2-9f35-4c577105516b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "andrew-pryce-media"
    }
  ]
}
