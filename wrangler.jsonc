{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-05-01",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "OPENAI_API_KEY": "REDACTED_OPENAI_KEY",
    "MUREKA_API_KEY": "REDACTED_MUREKA_KEY"
  }
}
