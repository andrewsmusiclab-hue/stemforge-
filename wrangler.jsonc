{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-05-01",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // API keys as vars — MVP approach so the deployed worker can call OpenAI + Mureka
  // Production upgrade: move to wrangler secret put once Genspark deploy supports it
  "vars": {
    "OPENAI_API_KEY": "REDACTED_OPENAI_KEY",
    "MUREKA_API_KEY": "REDACTED_MUREKA_KEY"
  },
  // KV namespace for persistent job store (survives across worker instances)
  "kv_namespaces": [
    {
      "binding": "JOBS_KV",
      "id": "PLACEHOLDER_KV_ID",
      "preview_id": "PLACEHOLDER_KV_PREVIEW_ID"
    }
  ]
}
