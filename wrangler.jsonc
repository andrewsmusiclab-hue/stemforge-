{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-05-01",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // API keys as vars — MVP approach so the deployed worker can call OpenAI + Mureka
  // Production upgrade: move to wrangler secret put once Genspark deploy supports it
  "vars": {
    "OPENAI_API_KEY": "REDACTED_OPENAI_KEY",
    "MUREKA_API_KEY": "REDACTED_MUREKA_KEY"
  },
  // KV namespace omitted — code falls back to in-memory memJobs Map.
  // Job data is ephemeral per worker instance (minutes-to-hours warm window).
  // Future: provision a real KV namespace via gsk and add the binding here.
}
